---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="What We Do">
    <div class="page-width">
        <div class="what-we-do-content">
            <div class="spacer-100"></div>
            <h1 class="title">WHAT WE DO</h1>
            <div class="spacer-50"></div>
            <p class="page-text" style="text-align: center;">
                348 (Ilkeston) Squadron offer a wide variety of training and activities that suit all interests and develop key skills for young people. We host a number of different courses and events on the squadron, including inter-squadron competitions, guest speakers and external visits from organisations like the RAF, Derbyshire Constabulary, Derbyshire Fire and Rescue Service and many more!
            </p>
            <div class="spacer-50"></div>
            <div class="what-we-do-layout">
                <div class="item">
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/s/cc_images/cache_6562828.JPG?t=1504611822" alt="" width="100%"></div>
                    <p class="page-text">Aviation: Flying and Gliding at RAF Wittering, model plane workshops, Flight Simulator and drone experiences and courses in aviation studies.</p>
                </div>
                <div class="item">
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/s/cc_images/cache_9006780.jpg" alt="" width="100%"></div>
                    <p class="page-text">Adventure Training: Fieldcraft, bushcraft, camping and road marching.</p>
                </div>
                <div class="item">
                    <p class="page-text">Duke Of Edinburgh: Qualified to deliver the full Bronze, Silver and Gold Awards in house with training and equipment provided.</p>
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/s/cc_images/cache_7267676.jpg?t=1510089202" alt="" width="100%"></div>
                </div>
                <div class="item">
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/s/cc_images/teaserbox_7500429.jpg?t=1512478032" alt="" width="100%"></div>
                    <p class="page-text">Shooting: Target practice, marksmanship training and inter-squadron shooting competitions.</p>
                </div>
                <div class="item">
                    <p class="page-text">Sports: Swimming, athletics and football championships along with fun outdoor activity and exercise.</p>
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/s/cc_images/cache_4634760.jpg?t=1492688021" alt=""></div>
                </div>
                <div class="item">
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/previous-activities/riat-2017/#" alt="" width="100%"></div>
                    <p class="page-text">First Aid: Qualified to deliver the Essential, Youth and Activity First Aid qualifications endorsed by Saint Johns Ambulance.</p>
                </div>
                <div class="item">
                    <p class="page-text">Leadership: Teamwork, development and activity scenarios and inter-squadron course and competitions.</p>
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/s/cc_images/cache_4634760.jpg?t=1492688021" alt=""></div>
                </div>
                <div class="item">
                    <div class="image"><img class="floating-image" src="https://www.348atc.co.uk/previous-activities/riat-2017/#" alt="" width="100%"></div>
                    <p class="page-text">STEM: Space, Radio and Cyber courses and qualifications.</p>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>